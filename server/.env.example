# General
NODE_ENV=development
PORT=5000

# Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bharatfix
# For Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/bharatfix

# Redis
REDIS_URL=redis://localhost:6379
# For Docker:
# REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info

# Email (Optional — notifications log to console if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@bharatfix.in
