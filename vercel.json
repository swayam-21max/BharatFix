{
  "version": 2,
  "buildCommand": "npm install --prefix client && npm run build --prefix client && npx prisma generate --schema=server/prisma/schema.prisma",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
